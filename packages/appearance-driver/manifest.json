{
  "id": "minex.appearance",
  "name": "Appearance Driver",
  "icon": "./assets/icon.svg",
  "version": "0.1.0",
  "minKernelVersion": "0.2.3",
  "entry": "./dist/index.js",
  "reloadable": true,
  "settingsSchema": {
    "type": "object",
    "groups": [
      {
        "title": "颜色设置",
        "properties": {
          "primaryColor": {
            "type": "color",
            "default": "#2563eb",
            "description": "主题色"
          },
          "backgroundColor": {
            "type": "color",
            "default": "#f3f6fb",
            "description": "背景色"
          },
          "warningColor": {
            "type": "color",
            "default": "#f59e0b",
            "description": "提示色"
          },
          "dangerColor": {
            "type": "color",
            "default": "#ef4444",
            "description": "警告色"
          }
        }
      },
      {
        "title": "字体设置",
        "properties": {
          "zhFont": {
            "type": "font",
            "enum": [
              "PingFang SC",
              "Microsoft YaHei",
              "SimHei",
              "SimSun",
              "Songti SC",
              "KaiTi",
              "FangSong",
              "Noto Sans CJK SC",
              "Source Han Sans SC"
            ],
            "default": "",
            "description": "全局中文"
          },
          "enFont": {
            "type": "font",
            "enum": [
              "Arial",
              "Georgia",
              "Times New Roman",
              "Verdana",
              "Tahoma",
              "Trebuchet MS",
              "Segoe UI",
              "Roboto",
              "Open Sans",
              "Courier New",
              "Consolas",
              "Impact",
              "Comic Sans MS"
            ],
            "default": "",
            "description": "全局英文"
          }
        }
      },
      {
        "title": "图标设置",
        "properties": {
          "iconTheme": {
            "type": "string",
            "enum": [
              "默认",
              "简约"
            ],
            "default": "默认",
            "description": "图标体系"
          }
        }
      }
    ]
  },
  "source": "本地",
  "description": "外观驱动：主题管理 + 全局外观设置（颜色/字体/图标），贡献 theme 给外壳",
  "dependencies": [
    "minex.markdown"
  ],
  "tags": [
    "外观",
    "主题"
  ],
  "kind": "driver"
}